<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.multidesk.explorer">
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />

    <application
        android:allowBackup="true"
        android:label="MultiDesk Explorer"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:screenOrientation="landscape"
            android:exported="true">
            <meta-data android:name="com.oculus.vr.default_display_metrics" android:value="1280x800" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SessionActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:documentLaunchMode="always"
            android:taskAffinity=""
            android:exported="false"
            android:resizeableActivity="true">
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp" />
            <meta-data android:name="com.oculus.vr.default_display_metrics" android:value="1280x800" />
        </activity>

        <service
            android:name=".tunnel.CloudflaredService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
